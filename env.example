DISCORD_BOT_TOKEN=put-your-bot-token-here

# Optional: limit posting to one server. Leave blank to search all servers the bot is in.
DISCORD_GUILD_ID=

# Fallback channel names. /setup stores per-server channel IDs and takes priority.
CHANNEL_FLAGS=flags-tracker
CHANNEL_API=api-dumps
CHANNEL_CPPTREE=cpptree-updates
CHANNEL_DEPLOYMENTS=deployment-updates

# Polling.
POLL_SECONDS=300

# Strongly recommended, not just optional. GitHub allows 60 unauthenticated API
# requests/hour. A single catch-up-after-being-offline cycle can use up to
# ~200 requests (one per missed commit, since each needs its own commit-detail
# fetch) plus the paging calls needed to walk back that far. Without a token
# that will 403 partway through and the rest of the backfill won't post until
# the next poll after the hourly quota resets.
#
# Fix: create a token at https://github.com/settings/tokens -> "Generate new
# token (classic)" -> no scopes needed (public repo read only) -> paste it here.
# That raises the limit to 5000/hour.
GITHUB_TOKEN=

# When true (the default), a totally fresh install (no data/state.json yet)
# immediately posts the 10 most recent flag-update commits instead of staying
# silent until the next change. Set to false if you'd rather the first run
# be silent.
BACKFILL_ON_FIRST_RUN=true
